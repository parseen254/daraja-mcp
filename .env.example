# Leave everything unset to run against the bundled simulator.

# simulator | sandbox | production
DARAJA_MODE=sandbox

# From your app on developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# PayBill or till. 174379 is the usual sandbox test shortcode.
DARAJA_SHORTCODE=174379

# Lipa na M-Pesa passkey, required for STK push and Ratiba
DARAJA_PASSKEY=

# Required for B2C, B2B, reversals, and balance queries
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=

# Public HTTPS URL Safaricom can reach. A localhost URL will never receive
# callbacks. Use ngrok or cloudflared during development.
DARAJA_CALLBACK_PUBLIC_URL=

DARAJA_CALLBACK_PORT=8787

# Unguessable path segment for callback URLs. Generate with:
#   openssl rand -hex 32
DARAJA_CALLBACK_PATH_SECRET=

# Where received callbacks are persisted
DARAJA_CALLBACK_STORE_DIR=.daraja-callbacks
